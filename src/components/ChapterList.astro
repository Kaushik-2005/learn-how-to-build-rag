---
import { getCollection } from 'astro:content';

const chapters = (await getCollection('chapters')).sort((a, b) => a.data.order - b.data.order);
const currentId = Astro.url.pathname.split('/').filter(Boolean).pop() ?? '';
---

<nav class="chapter-list-nav" aria-labelledby="chapter-list-title">
  <p id="chapter-list-title">Chapters</p>
  <ol>
    {chapters.map((chapter) => (
      <li>
        <a class:list={{ active: chapter.id === currentId }} href={`/chapters/${chapter.id}`} aria-current={chapter.id === currentId ? 'page' : undefined}>
          <span class="chapter-list-number">{String(chapter.data.order).padStart(2, '0')}</span>
          <span>{chapter.data.navTitle ?? chapter.data.title}</span>
        </a>
      </li>
    ))}
  </ol>
</nav>

<style>
  .chapter-list-nav { position: sticky; top: 5rem; max-height: calc(100vh - 6rem); overflow-y: auto; padding: 0 1rem 2rem 0; }
  .chapter-list-nav > p { margin: 0 0 1.2rem; color: var(--ink); font-size: .95rem; font-weight: 700; }
  .chapter-list-nav ol { display: flex; flex-direction: column; gap: .18rem; padding: 0; margin: 0; list-style: none; }
  .chapter-list-nav a { display: grid; grid-template-columns: 2rem 1fr; gap: .55rem; padding: .65rem .7rem; border-radius: 9px; color: var(--ink-muted); font-size: .84rem; line-height: 1.35; text-decoration: none; }
  .chapter-list-nav a:hover { color: var(--accent); background: var(--surface); }
  .chapter-list-nav a.active { color: var(--accent); background: var(--accent-bg); }
  .chapter-list-number { color: var(--ink-soft); font: .72rem Consolas, monospace; padding-top: .1rem; }
  .chapter-list-nav a.active .chapter-list-number { color: var(--accent); }
</style>
