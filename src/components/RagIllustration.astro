        <strong class="metric-formula">‖q-d‖₂ = √Σ(q<sub>i</sub>-d<sub>i</sub>)²</strong>
        <svg viewBox="0 0 180 110" aria-hidden="true"><line class="metric-axis" x1="20" y1="90" x2="164" y2="90"/><line class="metric-axis vertical" x1="28" y1="18" x2="28" y2="96"/><line class="metric-guide" x1="48" y1="76" x2="48" y2="90"/><line class="metric-guide" x1="132" y1="34" x2="132" y2="90"/><line class="metric-distance" x1="48" y1="76" x2="132" y2="34"/><circle class="metric-origin" cx="48" cy="76" r="4.2"/><circle class="metric-proj-dot" cx="132" cy="34" r="4.2"/><text x="34" y="82">q</text><text x="138" y="34">d</text><text class="metric-label metric-distance-label" x="74" y="43">‖q-d‖₂</text></svg>
        <p>Measure straight-line separation in the space.</p>
      </section>
    </div>
