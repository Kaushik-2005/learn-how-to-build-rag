---
interface Props { kind: 'rag-basics' | 'cleaning' | 'chunking' | 'embeddings' | 'hnsw-layers' | 'ivf-pq' | 'sources' | 'vector-record' | 'context-flow' | 'context-assembly' | 'bi-cross-encoders' | 'grounded-generation' | 'evaluation' | 'debugging-map' | 'advanced-patterns' | 'production-loop' | 'loading-flow' | 'extract-structure' | 'chunk-position' | 'prep-flow' | 'embedding-flow' | 'recursive-flow' | 'decision-record' | 'query-workbench' | 'query-position' | 'search-vs-rag' | 'record-cutaway' | 'lifecycle-pair' | 'vector-encoding' | 'similarity-metrics' | 'retrieval-candidates' | 'hybrid-fusion' | 'reranking'; label?: string; }
const { kind, label } = Astro.props;
const labels = {
  'rag-basics': 'Model memory complemented by retrieved, traceable external evidence',
  cleaning: 'Document preparation from raw source to traceable document',
  chunking: 'Document divided into retrieval chunks while retaining context',
  embeddings: 'Text chunks represented as points in an embedding space',
  'search-modes': 'Exact search compares every vector while approximate search visits a subset of the space',
  'hnsw-layers': 'HNSW searches from sparse upper graph layers into denser local neighborhoods',
  'ivf-pq': 'IVF probes selected vector partitions while product quantization stores compact codes',
  sources: 'Different source types becoming one document record',
  'vector-record': 'An embedding stored together with identity, provenance, metadata, and access constraints',
  'context-flow': 'Retrieved chunks expanded into final generation context',
  'context-assembly': 'Relevant retrieved passages are selected, expanded, ordered, and packed into a source-traceable context within a token budget',
  'bi-cross-encoders': 'Bi-encoders independently encode searchable queries and passages; cross-encoders jointly score each query-passage pair',
  'grounded-generation': 'Instructions, a question, and source-labeled evidence form a prompt; generated claims are checked against supplied evidence or qualified',
  evaluation: 'Retrieval relevance and generated-answer quality are measured separately on a fixed, traceable evaluation set',
  'debugging-map': 'Follow evidence through the RAG pipeline and find the earliest stage where the correct evidence disappears',
  'advanced-patterns': 'Choose advanced retrieval patterns to address specific bottlenecks, with added complexity and cost made visible',
  'production-loop': 'Production RAG couples ingestion and versioned indexes with governed query serving, observability, and feedback',
  'loading-flow': 'A source loader extracting content and metadata into a document record',
  'extract-structure': 'Structured source content can lose relationships when flattened during extraction',
  'chunk-position': 'Chunking highlighted between loading and embedding in the indexing path',
  'prep-flow': 'Raw source transformed into prepared text before chunking',
  'embedding-flow': 'Chunks and queries transformed into compatible vectors for search',
  'recursive-flow': 'Recursive chunking preserves larger boundaries before making smaller cuts',
  'decision-record': 'A compact record of the boundaries, limits, overlap, and traceability rules for chunking',
  'query-workbench': 'A raw multi-part question keeps its entities and constraints as it is separated into focused search questions',
  'query-position': 'Query processing highlighted between the incoming question and retrieval in the query-time path',
  'search-vs-rag': 'A search system returns ranked evidence while RAG turns retrieved evidence into a synthesized response',
  'record-cutaway': 'A searchable representation is linked by record identity to recoverable text and source metadata',
  'lifecycle-pair': 'Document indexing and query handling have separate lifecycles connected by IDs and versions',
  'vector-encoding': 'Text enters an embedding encoder and becomes a model-specific numerical vector',
  'similarity-metrics': 'Cosine, dot product, and Euclidean distance compare vectors using direction, alignment, and geometric separation',
  'retrieval-candidates': 'A query ranks matching evidence passages and returns a limited candidate set rather than an answer',
  'hybrid-fusion': 'Dense and sparse retrievers produce different ranked lists that are deduplicated and fused into a single candidate ranking',
  reranking: 'A relevance model jointly scores retrieved query-passage pairs to reorder a shortlist, then diversity selection reduces redundancy'
};
const flowData: Record<string, { title: string; note: string; steps: string[]; active?: number }> = {
  'context-flow': { title: 'CONTEXT CONSTRUCTION / 05', note: 'retrieve precisely / expand carefully / format for generation', steps: ['Prepared document', 'Parent section', 'Child chunks', 'Retrieve candidates', 'Expand context', 'Final context'] },
  'loading-flow': { title: 'LOADER CONTRACT / 03', note: 'content + metadata + source identity + location', steps: ['Source system', 'Loader', 'Content', 'Metadata', 'Document record'], active: 1 },
  'chunk-position': { title: 'INDEXING PATH / 05', note: 'each stage answers a different question', steps: ['Sources', 'Loading', 'Preparation', 'Chunking', 'Embedding', 'Vector index'], active: 3 },
  'query-position': { title: 'QUERY-TIME PATH / 08', note: 'shape the request before search / retrieval returns evidence candidates', steps: ['User question', 'Query processing', 'Query embedding', 'Candidate retrieval', 'Reranking', 'Context construction'], active: 1 },
  'prep-flow': { title: 'PREPARATION RECORD / 04', note: 'retain the artifacts needed to diagnose information loss', steps: ['Raw source', 'Extracted representation', 'Prepared representation', 'Ready to chunk'], active: 2 },
  'embedding-flow': { title: 'EMBEDDING FLOW / 06', note: 'same representation contract on both sides of search', steps: ['Text chunk', 'Encoder', 'Document vector', 'Query vector', 'Similarity', 'Candidates'] },
};
const flow = flowData[kind as keyof typeof flowData];
---

<div class:list={['rag-illustration', `is-${kind}`]} role="img" aria-label={label ?? labels[kind]}>
  {flow && <div class="flow-illustration">
    <div class="illustration-kicker">{flow.title}</div>
    <div class="flow-track">
      {flow.steps.map((step, index) => <><span class:list={{ 'flow-final': index === (flow.active ?? flow.steps.length - 1) }}>{step}</span>{index < flow.steps.length - 1 && <b>&rarr;</b>}</>)}
    </div>
    <p class="illustration-note">{flow.note}</p>
  </div>}

  {kind === 'rag-basics' && <>
    <div class="illustration-kicker">TWO KINDS OF MEMORY / 01</div>
    <div class="memory-scene">
      <section class="memory-model">
        <small>PARAMETRIC MEMORY</small>
        <div class="memory-orb"><i></i><i></i><i></i><i></i><i></i><i></i><b>MODEL</b></div>
        <strong>Broad learned patterns</strong>
        <span>useful, but not a live source collection</span>
      </section>
      <div class="memory-question"><small>QUESTION</small><strong>What does the current policy require?</strong></div>
      <section class="memory-library">
        <small>EXTERNAL SOURCES</small>
        <div class="memory-file old"><b>Policy · v3</b><span>superseded</span></div>
        <div class="memory-file selected"><b>Policy · v4</b><span>current evidence</span></div>
        <div class="memory-file"><b>Source · §2</b><span>page + version retained</span></div>
      </section>
      <div class="memory-caption"><span>retrieval selects evidence for this question</span><b>answer can point back to the source</b></div>
    </div>
  </>}

  {kind === 'query-workbench' && <>
    <div class="illustration-kicker">QUERY WORKBENCH / 08</div>
    <div class="query-scene">
      <div class="query-original"><small>RAW QUESTION</small><p>For <em>Atlas</em> <em>v4</em>, what changed in the <em>2025 retention policy</em>, and which team owns rollout?</p></div>
      <div class="query-constraints"><small>KEEP THESE ANCHORS</small><span>product · Atlas</span><span>version · v4</span><span>time · 2025</span></div>
      <div class="query-branches-label">SPLIT THE INFORMATION NEED</div>
      <div class="query-branches">
        <article><small>01 / CHANGE</small><strong>What changed in Atlas v4's retention policy for 2025?</strong><span>Locate the versioned policy evidence.</span></article>
        <div class="query-dependency"><b>&darr;</b><span>use the identified change</span></div>
        <article class="query-owner"><small>02 / RESPONSIBILITY</small><strong>Which team owns rolling out that policy change?</strong><span>Resolve the dependent entity.</span></article>
      </div>
    </div>
    <p class="illustration-note">reshape the search request / preserve the user's constraints / keep the original question</p>
  </>}

  {kind === 'retrieval-candidates' && <>
    <div class="illustration-kicker">RANKING EVIDENCE / 09</div>
    <div class="retrieval-scene">
      <section class="retrieval-query"><small>SEARCH REQUEST</small><strong>Who owns credential rotation?</strong><span>scope: current version · permitted records</span></section>
      <div class="retrieval-match" aria-hidden="true"><i></i><i></i><i></i></div>
      <section class="retrieval-pool">
        <small>INDEXED PASSAGES / RANKED BY MATCH</small>
        <article class="retrieval-hit selected"><b>01</b><span>Service credentials are rotated every 30 days by Identity Operations.</span><i>selected</i></article>
        <article class="retrieval-hit selected"><b>02</b><span>Credential lifecycle and account ownership guide.</span><i>selected</i></article>
        <article class="retrieval-hit selected"><b>03</b><span>Rotation exceptions for contracted service accounts.</span><i>selected</i></article>
        <div class="retrieval-boundary"><span></span><small>TOP K / CANDIDATE CUTOFF</small><span></span></div>
        <article class="retrieval-hit"><b>04</b><span>General password guidance for employees.</span><i>below cutoff</i></article>
        <article class="retrieval-hit"><b>05</b><span>Unrelated travel reimbursement policy.</span><i>below cutoff</i></article>
      </section>
    </div>
    <p class="illustration-note">ranked passages are evidence candidates / not yet final context or an answer</p>
  </>}

  {kind === 'hybrid-fusion' && <>
    <div class="illustration-kicker">TWO RANKINGS / ONE CANDIDATE LIST / 10</div>
    <div class="hybrid-query"><small>ONE SEARCH REQUEST</small><strong>For IAM-42, who owns 30-day credential rotation?</strong></div>
    <div class="hybrid-scene">
      <section class="hybrid-lane dense-lane">
        <header><small>DENSE / MEANING</small><span>paraphrases can match</span></header>
        <article><b>01</b><span>A · Service account rotation policy</span></article>
        <article><b>02</b><span>C · Cloud key rotation guide</span></article>
        <article><b>03</b><span>B · Identity Operations / IAM-42</span></article>
      </section>
      <div class="hybrid-join"><i></i><i></i><i></i><span>fuse<br/>ranks</span></div>
      <section class="hybrid-lane sparse-lane">
        <header><small>SPARSE / TERMS</small><span>exact IDs can match</span></header>
        <article><b>01</b><span>B · Identity Operations / IAM-42</span></article>
        <article><b>02</b><span>A · Service account rotation policy</span></article>
        <article><b>03</b><span>D · Account access standard</span></article>
      </section>
      <section class="hybrid-result">
        <header><small>FUSED CANDIDATES</small><span>same passage appears once</span></header>
        <article class="fused-first"><b>01</b><span>A · Supported by both lists</span><i>dense 1 + sparse 2</i></article>
        <article class="fused-second"><b>02</b><span>B · Exact ID + semantic match</span><i>dense 3 + sparse 1</i></article>
        <div class="fused-tail">other candidates follow</div>
      </section>
    </div>
    <p class="illustration-note">fusion reconciles rankings / it does not create evidence or verify relevance</p>
  </>}

  {kind === 'reranking' && <>
    <div class="illustration-kicker">READ THE SHORTLIST AGAIN / 11</div>
    <div class="rerank-query"><small>QUERY</small><strong>Who owns the 30-day credential rotation?</strong></div>
    <div class="rerank-scene">
      <section class="rerank-column">
        <header><small>RETRIEVED CANDIDATES / 5</small><span>first-stage order</span></header>
        <article><b>01</b><span>Credentials have a scheduled rotation policy.</span></article>
        <article><b>02</b><span>Identity Operations owns 30-day rotation.</span></article>
        <article class="redundant"><b>03</b><span>Duplicate: same owner and rotation rule.</span></article>
        <article><b>04</b><span>Contractor accounts have a rotation exception.</span></article>
        <article class="low-relevance"><b>05</b><span>General employee password guidance.</span></article>
      </section>
      <div class="rerank-reader"><i></i><i></i><i></i><b>score all 5<br/>query + passage</b><span>keep top 3</span></div>
      <section class="rerank-column reranked-column">
        <header><small>RERANKED / TOP 3</small><span>new relevance order</span></header>
        <article class="rerank-best"><b>01</b><span>Identity Operations owns 30-day rotation.</span></article>
        <article><b>02</b><span>Credentials have a scheduled rotation policy.</span></article>
        <article><b>03</b><span>Contractor rotation exception.</span></article>
      </section>
    </div>
    <div class="rerank-diversity"><small>DIVERSITY-AWARE SELECTION</small><span class="diversity-chip chosen">direct answer</span><b>+</b><span class="diversity-chip chosen">distinct supporting detail</span><span class="diversity-skip">duplicate left out</span></div>
    <p class="illustration-note">rerank only what retrieval found / leave room for distinct evidence</p>
  </>}

  {kind === 'bi-cross-encoders' && <>
    <div class="illustration-kicker">TWO WAYS TO COMPARE QUERY AND PASSAGE / 11</div>
    <div class="encoder-compare">
      <section class="encoder-mode bi-mode">
        <header><small>BI-ENCODER</small><span>encode separately</span></header>
        <div class="bi-route">
          <div class="bi-inputs"><article><small>QUERY</small><b>rotation owner?</b></article><article><small>PASSAGE</small><b>30-day policy...</b></article></div>
          <div class="bi-encoders"><span>query<br/>encoder</span><span>passage<br/>encoder</span></div>
          <div class="bi-vectors"><i>q → [ .2, .8, … ]</i><i>d → [ .3, .7, … ]</i></div>
        </div>
        <div class="bi-index"><small>PASSAGE VECTORS STORED AHEAD</small><span>p₁ ··· p₂ ··· p₃ ··· pₙ</span></div>
        <p>Compare vectors to search a large corpus.</p>
      </section>
      <section class="encoder-mode cross-mode">
        <header><small>CROSS-ENCODER</small><span>score each pair jointly</span></header>
        <div class="cross-pairs">
          <article class="cross-pair high"><div><small>QUERY</small><b>rotation owner?</b><i>+</i><small>PASSAGE 02</small><b>Identity Ops owns rotation.</b></div><strong>high<br/>relevance</strong></article>
          <article class="cross-pair"><div><small>QUERY</small><b>rotation owner?</b><i>+</i><small>PASSAGE 01</small><b>Rotation policy: 30 days.</b></div><strong>score</strong></article>
        </div>
        <p>Joint interaction is useful for scoring a bounded candidate set.</p>
      </section>
    </div>
    <p class="illustration-note">separate vectors scale to corpus search / joint query–passage scoring refines retrieved candidates</p>
  </>}

  {kind === 'grounded-generation' && <>
    <div class="illustration-kicker">EVIDENCE INTO A TRACEABLE ANSWER / 13</div>
    <div class="generation-scene">
      <section class="generation-prompt">
        <header><small>ASSEMBLED PROMPT</small><span>clear roles · labeled evidence</span></header>
        <article><b>INSTRUCTIONS</b><span>Answer from the supplied sources; cite each factual claim. If evidence is insufficient, say so.</span></article>
        <article><b>QUESTION</b><span>Who owns rotation, and how often?</span></article>
        <article class="generation-source"><b>[S1 · policy §3]</b><span>Identity Operations owns service-account rotation.</span></article>
        <article class="generation-source"><b>[S2 · policy §3.2]</b><span>Credentials must rotate every 30 days.</span></article>
      </section>
      <div class="generation-bridge"><i></i><i></i><i></i><span>generate<br/>from context</span></div>
      <section class="generation-output">
        <header><small>ANSWER CLAIMS</small><span>trace each claim</span></header>
        <article class="claim-supported"><b>SUPPORTED</b><span>Identity Operations owns rotation <em>[S1]</em>.</span></article>
        <article class="claim-supported"><b>SUPPORTED</b><span>The interval is 30 days <em>[S2]</em>.</span></article>
        <article class="claim-unsupported"><b>NOT IN EVIDENCE</b><span>“All teams follow this policy.”</span><i>omit · qualify · or abstain</i></article>
      </section>
    </div>
    <p class="illustration-note">instructions guide generation / source-linked claims make support inspectable / neither guarantees truth</p>
  </>}

  {kind === 'evaluation' && <>
    <div class="illustration-kicker">TWO SCORECARDS / ONE REPRODUCIBLE TEST SET / 14</div>
    <div class="eval-question"><small>FIXED TEST QUERY</small><strong>Who owns rotation, and how often?</strong><span>known relevant evidence: S1 + S2</span></div>
    <div class="eval-lanes">
      <section class="eval-lane">
        <header><small>RETRIEVAL</small><span>did evidence arrive?</span></header>
        <div class="eval-results"><article class="eval-hit"><b>01</b><span>General credential guide</span></article><article class="eval-hit relevant"><b>02</b><span>Owner: Identity Operations [S1]</span></article><article class="eval-hit relevant"><b>03</b><span>Interval: 30 days [S2]</span></article></div>
        <div class="eval-measures"><i>Recall@k</i><i>MRR</i><i>nDCG</i><i>latency</i></div>
      </section>
      <div class="eval-separator"><span>then</span></div>
      <section class="eval-lane generation-lane">
        <header><small>GENERATION</small><span>did answer use it well?</span></header>
        <article class="eval-answer"><b>ANSWER</b><span>Identity Operations owns rotation [S1]. Interval: 30 days [S2].</span></article>
        <div class="eval-measures"><i>correctness</i><i>faithfulness</i><i>citation support</i><i>abstention</i></div>
      </section>
    </div>
    <p class="illustration-note">same queries and evidence labels / score retrieval and answer quality separately</p>
  </>}

  {kind === 'debugging-map' && <>
    <div class="illustration-kicker">TRACE THE EVIDENCE / 15</div>
    <div class="debug-question"><small>EXPECTED EVIDENCE</small><strong>Rotation owner: Identity Operations · source §3</strong></div>
    <div class="debug-timeline">
      <article class="debug-stage intact"><small>01 / SOURCE</small><b>present</b><span>policy §3</span></article><i>→</i>
      <article class="debug-stage broken"><small>02 / LOADER</small><b>lost here</b><span>table row omitted</span></article><i>→</i>
      <article class="debug-stage downstream"><small>03 / INDEX</small><b>not indexed</b><span>no matching chunk</span></article><i>→</i>
      <article class="debug-stage downstream"><small>04 / RETRIEVAL</small><b>not found</b><span>candidate absent</span></article><i>→</i>
      <article class="debug-stage downstream"><small>05 / ANSWER</small><b>unsupported</b><span>model guesses</span></article>
    </div>
    <div class="debug-lens"><span>START AT THE FIRST BROKEN TRACE</span><b>downstream symptoms are consequences, not the cause</b></div>
    <p class="illustration-note">verify each handoff with source IDs, extracted text, chunks, ranked results, context, and claims</p>
  </>}

  {kind === 'advanced-patterns' && <>
    <div class="illustration-kicker">A PATTERN IS A RESPONSE TO A BOTTLENECK / 16</div>
    <div class="pattern-map">
      <div class="pattern-core"><small>BASELINE RAG</small><strong>retrieve → rerank → construct context</strong><span>keep the simple path unless a measured need says otherwise</span></div>
      <div class="pattern-branches">
        <article><small>QUESTION IS AMBIGUOUS OR MULTI-PART</small><b>rewrite · route · decompose</b><span>more targeted searches ↗ more calls and query drift</span></article>
        <article><small>PASSAGES NEED STRUCTURE OR CONTEXT</small><b>parent/child · windows · hierarchy</b><span>recover neighboring meaning ↗ larger or costlier context</span></article>
        <article><small>ONE VECTOR SCORE IS TOO COARSE</small><b>multi-vector · late interaction</b><span>fine-grained matching ↗ storage and scoring work</span></article>
        <article><small>RETRIEVAL MAY BE WEAK OR GLOBAL</small><b>CRAG · iterative · GraphRAG</b><span>correct, search again, or summarize relations ↗ complexity</span></article>
        <article><small>NEED ADAPTIVE OR NON-TEXT EVIDENCE</small><b>Self-RAG · agentic · multimodal</b><span>reflect, plan, or align modalities ↗ control and safety burden</span></article>
      </div>
    </div>
    <p class="illustration-note">identify the failure first / add only the mechanism that addresses it / measure its new costs</p>
  </>}

  {kind === 'production-loop' && <>
    <div class="illustration-kicker">SERVE · OBSERVE · UPDATE · VERIFY / 17</div>
    <div class="ops-scene">
      <section class="ops-ingest"><small>CONTROLLED INGESTION</small><article><b>source change</b><span>version · permissions · provenance</span></article><article><b>build index vNext</b><span>extract · chunk · embed · validate</span></article><div class="ops-switch">validate → promote<br/>rollback if needed</div><article class="ops-active"><b>active index vN</b><span>known-good version remains recoverable</span></article></section>
      <div class="ops-traffic"><span>authorized query traffic</span><b>→</b><span>retrieval + generation</span><b>→</b><span>traceable answer</span></div>
      <section class="ops-controls"><article><small>ACCESS &amp; PRIVACY</small><b>identity · tenant · source ACL</b><span>enforce before evidence reaches context</span></article><article><small>OBSERVABILITY</small><b>latency · cost · retrieval trace</b><span>version every stage and model</span></article><article><small>QUALITY LOOP</small><b>evaluation · feedback · incidents</b><span>review → fix source stage → retest</span></article></section>
      <div class="ops-feedback"><span>observed failures and reviewed feedback inform the next validated release</span><b>↶</b></div>
    </div>
    <p class="illustration-note">serve only governed, observable versions / feed measured failures into controlled updates</p>
  </>}

  {kind === 'context-assembly' && <>
    <div class="illustration-kicker">FROM CANDIDATES TO MODEL CONTEXT / 12</div>
    <div class="context-question"><small>QUESTION</small><strong>Who owns credential rotation, and what is its interval?</strong></div>
    <div class="context-build">
      <section class="context-evidence">
        <header><small>RERANKED CANDIDATES</small><span>select · deduplicate · expand</span></header>
        <article class="context-passage chosen"><b>01</b><span><strong>Identity Operations</strong> owns service-account rotation.</span><i>[policy §3]</i></article>
        <article class="context-passage chosen"><b>02</b><span>Credentials must rotate every <strong>30 days</strong>.</span><i>[policy §3.2]</i></article>
        <article class="context-passage context-duplicate"><b>03</b><span>Duplicate wording of the 30-day rule.</span><i>omitted</i></article>
        <article class="context-passage context-conflict"><b>04</b><span>Older guide says <strong>60 days</strong>.</span><i>retain date / flag conflict</i></article>
      </section>
      <div class="context-bridge"><i></i><i></i><i></i><span>fit to<br/>budget</span></div>
      <section class="context-packet">
        <header><small>ASSEMBLED EVIDENCE</small><span>source labels retained</span></header>
        <article><b>[policy §3]</b><span>Owner: Identity Operations.</span></article>
        <article><b>[policy §3.2]</b><span>Interval: every 30 days.</span></article>
        <article class="packet-conflict"><b>[guide · older]</b><span>Conflicting interval: 60 days; verify effective version.</span></article>
        <div class="packet-budget"><span>CONTEXT ALLOCATION</span><i><b></b></i><strong>evidence + question + instructions &lt; input limit</strong></div>
      </section>
    </div>
    <p class="illustration-note">preserve provenance and disagreement / spend the context budget on useful evidence</p>
  </>}

  {kind === 'vector-encoding' && <>
    <div class="illustration-kicker">TEXT BECOMES COORDINATES / 06</div>
    <div class="encoding-scene">
      <section class="encoding-input"><small>TEXT CHUNK</small><strong>“Rotate the service credential every 30 days.”</strong><span>meaning-bearing input</span></section>
      <div class="encoding-lens"><i></i><i></i><i></i><b>ENCODER</b></div>
      <section class="encoding-output"><small>SCHEMATIC VECTOR VALUES</small><div><span>d₁</span><b>0.12</b></div><div><span>d₂</span><b>-0.04</b></div><div><span>d₃</span><b>0.77</b></div><div class="encoding-ellipsis">…</div><div><span>dₙ</span><b>…</b></div></section>
    </div>
    <p class="illustration-note">coordinates are learned signals across dimensions / they are not individually readable facts</p>
  </>}

  {kind === 'similarity-metrics' && <>
    <div class="illustration-kicker">THREE VIEWS OF VECTOR SIMILARITY / 06</div>
    <div class="metric-grid">
      <section class="metric-panel">
        <small>01 / COSINE</small>
        <strong class="metric-formula">cos(q,d) = <span>q · d</span> / (<i>‖q‖ ‖d‖</i>)</strong>
        <svg viewBox="0 0 180 110" aria-hidden="true"><line class="metric-axis" x1="20" y1="90" x2="164" y2="90"/><line class="metric-vector" x1="28" y1="84" x2="137" y2="34"/><line class="metric-vector soft" x1="28" y1="84" x2="133" y2="69"/><path class="metric-arc" d="M65 59 A45 45 0 0 1 72 77"/><circle class="metric-origin" cx="28" cy="84" r="4"/><text x="140" y="32">q</text><text x="136" y="72">d</text><text class="metric-label" x="61" y="78">θ</text></svg>
        <p>Compare direction; vector length is normalized away.</p>
      </section>
      <section class="metric-panel">
        <small>02 / DOT PRODUCT</small>
        <strong class="metric-formula">q · d = Σ q<sub>i</sub>d<sub>i</sub><span>q · d = ‖q‖ ‖d‖ cos θ</span></strong>
